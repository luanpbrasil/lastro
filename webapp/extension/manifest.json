{
  "manifest_version": 3,
  "name": "Lastro",
  "version": "0.2.0",
  "description": "Where each economic idea in the YouTube video you're watching comes from, who disagrees, and what the official numbers say.",
  "key": "",
  "minimum_chrome_version": "116",
  "permissions": ["storage", "scripting", "tabCapture", "offscreen"],
  "host_permissions": ["https://www.youtube.com/*", "https://x.com/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "content_scripts": [
    { "matches": ["https://www.youtube.com/*"], "js": ["hook.js"], "run_at": "document_start", "world": "MAIN" },
    { "matches": ["https://www.youtube.com/*"], "js": ["content.js"], "run_at": "document_start" },
    { "matches": ["https://x.com/*"], "js": ["x-content.js"], "run_at": "document_idle" }
  ],
  "action": {
    "default_title": "Lastro: listen to this video (for videos without captions)",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" }
  },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "commands": {
    "_execute_action": { "suggested_key": { "default": "Alt+Shift+L" }, "description": "Listen to this video" }
  },
  "web_accessible_resources": [{ "resources": ["fonts/*"], "matches": ["https://www.youtube.com/*"] }]
}
