{
  "name": "lastro-live",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite build && vite preview",
    "deploy": "vite build && wrangler deploy",
    "db:local": "wrangler d1 migrations apply lastro-live --local",
    "db:remote": "wrangler d1 migrations apply lastro-live --remote",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.web.json"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.67.0",
    "vite": "8.3.5",
    "wrangler": "^4.158.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "@fontsource-variable/schibsted-grotesk": "5.3.0"
  }
}
