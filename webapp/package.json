{
  "name": "lastro-live",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite build && vite preview",
    "deploy": "vite build && wrangler deploy",
    "db:local": "wrangler d1 migrations apply lastro-live --local",
    "db:remote": "wrangler d1 migrations apply lastro-live --remote",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p extension/tsconfig.json",
    "ext:build": "node extension/build.mjs",
    "ext:dev": "node extension/build.mjs --watch --worker http://127.0.0.1:8788",
    "ext:zip": "node extension/build.mjs --store",
    "test:notes": "node --test tests/notes.test.mjs",
    "test:language": "node --test tests/language.test.mjs",
    "test:post-lang": "node --test tests/post-lang.test.mjs",
    "test:posts": "pnpm run test:posts:worker && pnpm run test:posts:extension",
    "test:posts:worker": "node --test --test-timeout=20000 tests/posts-worker.test.mjs",
    "test:posts:extension": "node --test --test-timeout=20000 tests/posts-extension.test.mjs"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.67.0",
    "@playwright/test": "^1.65.0",
    "@types/chrome": "^0.3.7",
    "esbuild": "^0.28.2",
    "miniflare": "5.20261104.0-beta",
    "vite": "8.3.5",
    "wrangler": "^4.158.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "@fontsource-variable/schibsted-grotesk": "5.3.0"
  }
}
