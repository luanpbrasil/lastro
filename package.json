{
  "name": "lastro",
  "private": true,
  "version": "0.1.0",
  "description": "Lastro: context cards for economics videos on YouTube (Hack Brasil 2026)",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.5.2",
  "scripts": {
    "dev:worker": "wrangler dev --port 8787",
    "build:ext": "node extension/build.mjs",
    "build:demo": "node extension/build.mjs --prod",
    "watch:ext": "node extension/build.mjs --watch",
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p extension",
    "eval": "esbuild scripts/eval.ts --bundle --platform=node --format=esm --log-level=warning --outfile=.cache/eval.mjs && node .cache/eval.mjs",
    "eval:web": "esbuild scripts/eval-web.ts --bundle --platform=node --format=esm --packages=external --log-level=warning --outfile=.cache/eval-web.mjs && node .cache/eval-web.mjs",
    "analyze": "esbuild scripts/analyze.ts --bundle --platform=node --format=esm --log-level=warning --outfile=.cache/analyze.mjs && node .cache/analyze.mjs",
    "facts": "esbuild scripts/facts-check.ts --bundle --platform=node --format=esm --log-level=warning --outfile=.cache/facts.mjs && node .cache/facts.mjs",
    "label": "esbuild scripts/label-topics.ts --bundle --platform=node --format=esm --log-level=warning --outfile=.cache/label.mjs && node .cache/label.mjs",
    "topics:tokens": "esbuild scripts/topics-tokens.ts --bundle --platform=node --format=esm --log-level=warning --outfile=.cache/topics-tokens.mjs && node .cache/topics-tokens.mjs",
    "topics:parity": "esbuild scripts/topics-parity.ts --bundle --platform=node --format=esm --log-level=warning --outfile=.cache/topics-parity.mjs && node .cache/topics-parity.mjs",
    "topics:train": "pnpm -s topics:tokens && scripts/classifier/.venv/bin/python -I scripts/classifier/train.py",
    "probe": "esbuild scripts/coverage-probe.ts --bundle --platform=node --format=esm --log-level=warning --outfile=.cache/probe.mjs && node .cache/probe.mjs",
    "build:site": "node site/build.mjs",
    "dev:web": "pnpm --filter lastro-live dev",
    "deploy:web": "pnpm --filter lastro-live run deploy"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "@cloudflare/workers-types": "^5.20261107.1",
    "@types/chrome": "^0.3.7",
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "wrangler": "^4.158.0"
  }
}
